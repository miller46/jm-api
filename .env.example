# jm-api environment template
# Copy to .env and customize per environment.

# --- Required ---
# Database DSN (PostgreSQL recommended for staging/production)
JM_API_DATABASE_URL=postgresql+psycopg2://jm_api:change-me@db:5432/jm_api
# JWT secret used when JM_API_JWT_SIGNING_KEYS is not set (>=32 bytes in prod)
JM_API_JWT_SECRET_KEY=replace-with-strong-32-byte-secret

# --- App runtime ---
JM_API_ENVIRONMENT=development
JM_API_DEBUG=false
JM_API_API_V1_PREFIX=/api/v1
JM_API_DB_MIGRATION_CHECK_ENABLED=true

# API documentation endpoints
JM_API_DOCS_ENABLED=true
JM_API_OPENAPI_URL=/openapi.json
JM_API_DOCS_URL=/docs
JM_API_REDOC_URL=/redoc

# Networking / proxy / CORS
JM_API_REQUEST_ID_HEADER=X-Request-ID
JM_API_MAX_REQUEST_BODY_BYTES=1048576
JM_API_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000
JM_API_CORS_ALLOW_CREDENTIALS=true
JM_API_CORS_ALLOW_METHODS=*
JM_API_CORS_ALLOW_HEADERS=*
JM_API_ALLOWED_HOSTS=localhost,127.0.0.1
JM_API_TRUST_PROXY_HEADERS=false
# Required when JM_API_TRUST_PROXY_HEADERS=true
JM_API_TRUSTED_PROXY_CIDRS=

# Bot-write safety controls
JM_API_BOTS_WRITE_ADMIN_ONLY=false
# Emergency override for staging/production only (prefer leaving false)
JM_API_I_UNDERSTAND_RISK=false

# Logging
JM_API_LOG_LEVEL=INFO
JM_API_LOG_JSON=true
JM_API_LOG_SAMPLE_RATE=1.0
JM_API_SLOW_QUERY_THRESHOLD_MS=500

# Metrics / tracing
JM_API_METRICS_ENABLED=true
JM_API_METRICS_PATH=/metrics
JM_API_TRACING_ENABLED=false
JM_API_TRACING_SERVICE_NAME=jm-api
JM_API_TRACING_SERVICE_VERSION=0.1.0
JM_API_TRACING_JAEGER_HOST=localhost
JM_API_TRACING_JAEGER_PORT=6831

# JWT/session behavior
JM_API_JWT_SIGNING_KEYS=
JM_API_JWT_ALGORITHM=HS256
JM_API_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JM_API_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JM_API_SESSION_CLEANUP_INTERVAL_SECONDS=300

# Rate limiting / quotas (use Redis URI in staging/production)
JM_API_RATE_LIMIT_STORAGE_URI=memory://
JM_API_RATE_LIMIT_API_PER_MINUTE=120
JM_API_RATE_LIMIT_API_PER_HOUR=3000
JM_API_RATE_LIMIT_QUOTA_PER_DAY=10000
JM_API_RATE_LIMIT_QUOTA_PER_MONTH=200000

# --- Redis configuration (optional but recommended for production) ---
# Redis URL (hostname or IP) - leave empty to disable Redis
JM_API_REDIS_URL=
# Redis port (default: 6379)
JM_API_REDIS_PORT=6379
# Redis password (optional, leave empty if no auth)
JM_API_REDIS_PASSWORD=
# Redis database number (default: 0)
JM_API_REDIS_DB=0
# Connection pool settings
JM_API_REDIS_CONNECTION_POOL_SIZE=10
JM_API_REDIS_CONNECTION_POOL_MAX=20
JM_API_REDIS_SOCKET_TIMEOUT=5
JM_API_REDIS_SOCKET_CONNECT_TIMEOUT=5
JM_API_REDIS_RETRY_ON_TIMEOUT=true
JM_API_REDIS_HEALTH_CHECK_INTERVAL=30

# --- Deployment metadata (optional) ---
# Exposed via /api/v1/meta endpoint for deployment tracking
# JM_API_GIT_SHA=$(git rev-parse --short HEAD)
# JM_API_DEPLOYED_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
