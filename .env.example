# Required
JM_API_DATABASE_URL=postgresql://jm_api:jm_api@localhost:5432/jm_api

# Database pool sizing (defaults: max=20, min=2)
# Small (dev/test): max=10, min=2
# Medium (production): max=20, min=5
# Large (high-load): max=50, min=10
JM_API_DB_POOL_MAX_CONNS=20
JM_API_DB_POOL_MIN_CONNS=2

# Environment
JM_API_ENVIRONMENT=development
JM_API_DEBUG=true
JM_API_API_V1_PREFIX=/api/v1
JM_API_DB_MIGRATION_CHECK_ENABLED=false
JM_API_DB_CONNECT_RETRY_ENABLED=true
JM_API_DB_CONNECT_RETRY_MAX_ATTEMPTS=5
JM_API_DB_CONNECT_RETRY_INITIAL_DELAY_SECONDS=1
JM_API_DB_CONNECT_RETRY_MAX_DELAY_SECONDS=30
JM_API_DB_QUERY_TIMEOUT=3s

# Networking / proxy / CORS
JM_API_REQUEST_ID_HEADER=X-Request-ID
JM_API_MAX_REQUEST_BODY_BYTES=1048576
JM_API_REQUEST_TIMEOUT_DEFAULT=30s
JM_API_REQUEST_TIMEOUT_BOT_QUERY=10s
JM_API_REQUEST_TIMEOUT_WEBHOOK=60s
JM_API_REQUEST_TIMEOUT_AUTH=5s
JM_API_REQUEST_TIMEOUT_HEALTH=2s
JM_API_WORKER_MAX_CONCURRENCY=10
JM_API_WORKER_MAX_PER_POLL=10
JM_API_WORKER_POLL_INTERVAL=5s
JM_API_WORKER_TASK_TIMEOUT=30s

JM_API_SCHEDULER_POLL_INTERVAL_SECONDS=30
JM_API_SCHEDULER_QUERY_LIMIT=10
JM_API_SCHEDULER_WORKER_POOL_SIZE=5
JM_API_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000
JM_API_CORS_ALLOW_CREDENTIALS=true
JM_API_CORS_ALLOW_METHODS=*
JM_API_CORS_ALLOW_HEADERS=*
JM_API_ALLOWED_HOSTS=localhost,127.0.0.1
JM_API_TRUST_PROXY_HEADERS=false
# Required when JM_API_TRUST_PROXY_HEADERS=true
JM_API_TRUSTED_PROXY_CIDRS=

# Bot-write safety controls
JM_API_BOTS_WRITE_ADMIN_ONLY=false
JM_API_I_UNDERSTAND_RISK=false

# Logging
JM_API_LOG_JSON=false
JM_API_LOG_LEVEL=DEBUG

# Metrics
JM_API_METRICS_ENABLED=false

# JWT/session behavior
# JM_API_JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JM_API_JWT_ALGORITHM=HS256
JM_API_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JM_API_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JM_API_SESSION_CLEANUP_GRACE_DAYS=7
JM_API_SESSION_CLEANUP_INTERVAL_SECONDS=300

# Redis (optional for local dev)
# JM_API_REDIS_URL=redis://localhost:6379
JM_API_REDIS_REQUIRED=false
